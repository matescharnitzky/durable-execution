# Use plain values or op:// references in your local .env.
# Optional 1Password sign-in address or account ID (a plain value, not op://).
OP_ACCOUNT=
# Leave database fields empty to use the local Compose defaults.
OPENAI_API_KEY=
LOGFIRE_TOKEN=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGADMIN_EMAIL=
PGADMIN_PASSWORD=


# Optional for projects whose Logfire region cannot be detected:
LOGFIRE_BASE_URL=
