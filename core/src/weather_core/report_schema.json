{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["forecast_date", "forecasts", "summary"],
  "properties": {
    "forecast_date": {"type": "string", "format": "date"},
    "summary": {"type": "string", "minLength": 1},
    "forecasts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["city", "low_c", "high_c", "conditions", "sources"],
        "properties": {
          "city": {"type": "string", "minLength": 1},
          "low_c": {"type": ["number", "null"]},
          "high_c": {"type": ["number", "null"]},
          "conditions": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "url"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri", "pattern": "^https?://"}
              }
            }
          }
        }
      }
    }
  }
}
